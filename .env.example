# SmartRecipe DeepReason local configuration
# Copy this file to .env. Never commit a real API key.

APP_NAME=SmartRecipe DeepReason
APP_VERSION=1.0.0
DEBUG=true
# Start with true. Change to false only after the environment check passes.
DEEPREASON_DEMO_MODE=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

# Alibaba Cloud Model Studio (Bailian)
# The API Key and API Host are displayed once when the key is created.
DASHSCOPE_API_KEY=
BAILIAN_WORKSPACE_ID=YOUR_WORKSPACE_ID
LLM_PROVIDER=openai
LLM_MODEL=qwen-plus
LLM_API_KEY=${DASHSCOPE_API_KEY}
LLM_BASE_URL=https://${BAILIAN_WORKSPACE_ID}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=${DASHSCOPE_API_KEY}
EMBEDDING_BASE_URL=https://${BAILIAN_WORKSPACE_ID}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

RERANK_ENABLED=true
RERANK_PROVIDER=custom
RERANK_MODEL=qwen3-rerank
RERANK_API_KEY=${DASHSCOPE_API_KEY}
RERANK_BASE_URL=https://${BAILIAN_WORKSPACE_ID}.cn-beijing.maas.aliyuncs.com/compatible-api/v1
RERANK_ENDPOINT=/reranks
RERANK_MAX_CANDIDATES=20
RERANK_TOP_N=6

# Optional multimodal models. They can reuse the same workspace key.
VISION_MODEL=qwen3-vl-plus
VISION_API_KEY=${DASHSCOPE_API_KEY}
VISION_BASE_URL=https://${BAILIAN_WORKSPACE_ID}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_DIMENSION=512
CLIP_DEVICE=auto
MILVUS_IMAGE_COLLECTION_NAME=recipe_image_embeddings
IMAGE_GENERATION_MODEL=qwen-image-plus
IMAGE_GENERATION_API_KEY=${DASHSCOPE_API_KEY}
IMAGE_GENERATION_BASE_URL=https://${BAILIAN_WORKSPACE_ID}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
IMAGE_GENERATION_SIZE=1024x1024

# Docker host ports. Redis uses 16379 because this machine already uses 6379.
MYSQL_HOST_PORT=13306
NEO4J_HTTP_PORT=17474
NEO4J_BOLT_PORT=17687
REDIS_HOST_PORT=16379
REDIS_INSIGHT_PORT=18081

REDIS_URL=redis://localhost:16379/0
DATABASE_URL=mysql+pymysql://recipe_user:recipepass@localhost:13306/recipe_db
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=recipes
